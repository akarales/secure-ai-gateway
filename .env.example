# Secure AI Gateway — environment
# Copy to .env and adjust. Never commit real .env files.

# Presidio sidecar (Python). APP_DETECTOR_STUB=true skips it entirely.
APP_DETECTOR_URL=http://localhost:8006
APP_DETECTOR_STUB=false

# Token map. APP_REDIS_STUB=true uses an in-process map (offline demo).
APP_REDIS_URL=redis://localhost:6380
APP_REDIS_STUB=false
APP_TOKEN_TTL=3600

# Model tier. APP_MODEL_STUB=true echoes the sanitized prompt (offline).
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen3:14b
APP_MODEL_STUB=false

# Append-only audit log (JSONL)
APP_AUDIT_PATH=data/audit.jsonl

# Port (8000-8004 taken on this machine)
APP_PORT=8005
